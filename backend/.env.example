# ── Providers ─────────────────────────────────────────────────────────────────
# Set each independently: local | vertexai | bedrock (for VECTOR_STORE/LLM_PROVIDER)
#                         local | gcs | s3      (for STORAGE_PROVIDER)
LLM_PROVIDER=local
VECTOR_STORE=local
STORAGE_PROVIDER=local

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://rag:ragpassword@localhost:5432/rag

# ── Ollama  (LLM_PROVIDER=local) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ── Local storage  (STORAGE_PROVIDER=local) ──────────────────────────────────
LOCAL_STORAGE_PATH=./uploads

# ── AWS  (LLM_PROVIDER=bedrock / VECTOR_STORE=bedrock / STORAGE_PROVIDER=s3) ─
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-account-dev-rag-docs
# BEDROCK_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_KNOWLEDGE_BASE_ID=XXXXXXXXXX
# BEDROCK_DATA_SOURCE_ID=XXXXXXXXXX
# AWS credentials — use IAM role in AWS; for local dev use env vars:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Google Cloud  (LLM_PROVIDER=vertexai / VECTOR_STORE=vertexai / STORAGE_PROVIDER=gcs) ─
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
# GCS_BUCKET_NAME=your-project-id-dev-rag-docs
# VERTEX_AI_LOCATION=us-central1
# EMBEDDING_MODEL=text-embedding-004
# DEFAULT_LLM_MODEL=gemini-1.5-pro
# VECTOR_SEARCH_INDEX_ID=projects/.../indexes/...
# VECTOR_SEARCH_ENDPOINT_ID=projects/.../indexEndpoints/...
# VECTOR_SEARCH_DEPLOYED_INDEX_ID=dev_rag_deployed

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
